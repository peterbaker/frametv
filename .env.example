# Samsung Frame TV
TV_IP=10.0.0.176
TV_NAME=FrameArtRotator

# Rijksmuseum API key — get one at https://data.rijksmuseum.nl/object-metadata/api/
RIJKS_API_KEY=

# Default fetch query
RIJKS_TYPE=schilderij
RIJKS_QUERY=landschap
RIJKS_COUNT=50

# Image directory & target resolution (Frame TV native is 3840x2160)
IMAGE_DIR=images
TARGET_WIDTH=3840
TARGET_HEIGHT=2160
